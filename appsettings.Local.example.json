{
  "Storage": {
    "Provider": "R2"
  },
  "R2": {
    "BucketName": "realworth-media",
    "Endpoint": "https://<account-id>.r2.cloudflarestorage.com",
    "PublicUrl": "https://pub-<id>.r2.dev",
    "AccessKeyId": "<from Cloudflare R2 API token>",
    "SecretAccessKey": "<from Cloudflare R2 API token>"
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=<host>;Database=realworthdb;User Id=<user>;Password=<password>;MultipleActiveResultSets=true;TrustServerCertificate=True;"
  },
  "Jwt": {
    "Secret": "<random, at least 32 characters>"
  },
  "PropertyData": {
    "UserAgent": "RealWorth/1.0 (+https://api.realworth.co.za; <contact email the City can reach>)"
  },
  "Imagery": {
    "GoogleMapsApiKey": "<optional: Google Maps key for satellite/Street View; restrict it by API and IP>"
  }
}