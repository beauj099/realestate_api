<?xml version="1.0" encoding="utf-8"?>
<configuration>
	<location path="." inheritInChildApplications="false">
		<system.webServer>
			<!-- Remove WebDAV modules that block DELETE/PUT -->
			<modules>
				<remove name="WebDAVModule" />
				<remove name="WebDAV" />
			</modules>

			<handlers>
				<add name="aspNetCore" path="*" verb="GET,HEAD,POST,PUT,DELETE,PATCH,OPTIONS" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
			</handlers>

			<!-- Allow all HTTP methods -->
			<security>
				<requestFiltering>
					<verbs allowUnlisted="true">
						<add verb="OPTIONS" allowed="true" />
						<add verb="DELETE" allowed="true" />
						<add verb="PUT" allowed="true" />
						<add verb="PATCH" allowed="true" />
					</verbs>
					<fileExtensions allowUnlisted="true" />
				</requestFiltering>
			</security>

			<aspNetCore processPath="dotnet" arguments=".\realestate_api.dll" stdoutLogEnabled="false" stdoutLogFile=".\logs\stdout" hostingModel="inprocess" />
		</system.webServer>
	</location>
</configuration>
