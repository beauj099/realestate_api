{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Storage": {
    "Provider": "Local"
  },
  "LocalStorage": {
    "BasePath": "wwwroot/uploads",
    "PublicPrefix": "/uploads/"
  },
  "R2": {
    "BucketName": "",
    "AccessKeyId": "",
    "SecretAccessKey": "",
    "Endpoint": "",
    "PublicUrl": ""
  },
  "Jwt": {
    "Secret": "CHANGE-ME-to-a-secret-key-at-least-32-characters-long",
    "Issuer": "RealEstateApi",
    "Audience": "RealEstateApi",
    "ExpiryHours": 1
  },
  "ConnectionStrings": {
    // Real value lives in appsettings.Local.json (git-ignored) -- see appsettings.Local.example.json.
    "DefaultConnection": ""
    //"DefaultConnection": "Server=.\\SQLEXPRESS;Database=PropertyListingsDB;Trusted_Connection=True;TrustServerCertificate=True;"
  }
}
